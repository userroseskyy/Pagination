@model IEnumerable<WebApplication1.Models.Person>
@{
    ViewData["Title"] = "Index";
}

<div class="row">
    @foreach(var item in Model)
    {
        <div class="col-md-4">
            <div class="well text-center">
                @item.FullName
                </div>
         </div>
        
    }

</div>
<div class="row text-center">
    <nav>
      <ul class="pagination">
       <li class="disabled">
                <a aria-label="Previous" href="#"><span aria-hidden="true">« </span></a>
            </li>
            @for(int i= 1; i<=(ViewBag.pagcount+1); i++)
            {
                <li class="@(((int)ViewBag.pagId==i)?"active":"")">
                    <a href="/Hom/Index?pagid=@i">@i <span class="sr-only">
                        (current)
                    </span></a>
                </li>
            }
            <li><a aria-label="Next" href="#"><span aria-hidden="true">»</span></a></li>
        </ul>

    </nav>

</div>
